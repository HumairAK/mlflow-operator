apiVersion: v1
kind: Pod
metadata:
  name: mlflow-api-test
  namespace: {{ .Namespace }}
spec:
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    seccompProfile:
      type: RuntimeDefault
  containers:
  - name: test
    image: python:3.11
    command:
    - /bin/bash
    - -c
    - |
      pip install --user -q git+https://github.com/opendatahub-io/mlflow.git &&
      python /scripts/test_mlflow_api.py --tracking-uri {{ .TrackingURI }}
    env:
    - name: HOME
      value: /tmp
    securityContext:
      allowPrivilegeEscalation: false
      capabilities:
        drop:
          - ALL
    volumeMounts:
    - name: test-script
      mountPath: /scripts
  volumes:
  - name: test-script
    configMap:
      name: mlflow-test-script
